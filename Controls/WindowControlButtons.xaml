<UserControl x:Class="ClassroomManagement.Controls.WindowControlButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="120"
             x:Name="WindowControlButtonsControl">
    
    <StackPanel Orientation="Horizontal">
        <!-- Minimize Button -->
        <Button x:Name="MinimizeButton"
                Style="{StaticResource WindowMinimizeButtonStyle}"
                Visibility="{Binding ShowMinimize, ElementName=WindowControlButtonsControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="MinimizeButton_Click">
            <materialDesign:PackIcon Kind="Minus" Width="10" Height="10"/>
        </Button>
        
        <!-- Maximize Button -->
        <Button x:Name="MaximizeButton"
                Style="{StaticResource WindowMaximizeButtonStyle}"
                Margin="4,0"
                Visibility="{Binding ShowMaximize, ElementName=WindowControlButtonsControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="MaximizeButton_Click">
            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="SquareOutline" Width="10" Height="10"/>
        </Button>
        
        <!-- Close Button -->
        <Button x:Name="CloseButton"
                Style="{StaticResource WindowCloseButtonStyle}"
                Click="CloseButton_Click">
            <materialDesign:PackIcon Kind="Close" Width="10" Height="10"/>
        </Button>
    </StackPanel>
</UserControl>
