<Window x:Class="ClassroomManagement.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:ClassroomManagement.Controls"
        mc:Ignorable="d"
        Title="Đăng nhập giáo viên"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="50" To="0" Duration="0:0:0.5" DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" Style="{StaticResource DialogWindowBorderStyle}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                    <controls:WindowControlButtons ShowMinimize="False" ShowMaximize="False"/>
                </StackPanel>
            </Grid>
            
            <!-- Main Content -->
            <StackPanel Grid.Row="1" Margin="40,0,40,40">
                
                <!-- Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border Width="72" Height="72" CornerRadius="24" Background="#E3F2FD" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="School" Width="40" Height="40" 
                                                  Foreground="{StaticResource AppPrimaryBrush}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chào mừng giáo viên quay trở lại." FontSize="14" Foreground="#757575" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel>
                    <!-- Username -->
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                             FontSize="14" Height="48" Margin="0,0,0,16"
                             BorderBrush="#E0E0E0"
                             Padding="12,10"/>
                    
                    <!-- Password -->
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                                 FontSize="14" Height="48"
                                 BorderBrush="#E0E0E0"
                                 Padding="12,10"
                                 KeyDown="PasswordBox_KeyDown"/>
                    
                    <!-- Error Message -->
                    <TextBlock x:Name="ErrorText" 
                               Text="Thông tin đăng nhập không chính xác"
                               Foreground="#D32F2F" FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                    
                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Content="ĐĂNG NHẬP"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource AppPrimaryBrush}"
                            Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            Height="50" Margin="0,24,0,0"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            materialDesign:ElevationAssist.Elevation="Dp2"
                            Click="LoginButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
