<Window Icon="pack://application:,,,/Resources/app.ico" x:Class="ClassroomManagement.Views.FileCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thu Thập File" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="8" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderDownload" Foreground="white" Width="32" Height="32" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Thu thập tài liệu học sinh" Foreground="white" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Thu thập file từ các máy tính học sinh trong lớp" Foreground="#B3FFFFFF" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Account" Foreground="white" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OnlineCountText" Text="0 học sinh trực tuyến" Foreground="white" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Settings -->
            <Border Background="#FAFAFA" CornerRadius="12" Padding="8" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Quick Path Selection -->
                        <TextBlock Text="CHỌN NHANH THƯ MỤC" FontWeight="Bold" FontSize="13" Foreground="#616161" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                            <Button x:Name="BtnDocuments" Click="QuickPath_Click" Tag="Documents"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Margin="0,0,8,8" Height="50" HorizontalContentAlignment="Left" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center" Width="20" Height="20"/>
                                    <TextBlock Text="Documents" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDownloads" Click="QuickPath_Click" Tag="Downloads"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Margin="0,0,0,8" Height="50" HorizontalContentAlignment="Left" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" Width="20" Height="20"/>
                                    <TextBlock Text="Downloads" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnPictures" Click="QuickPath_Click" Tag="Pictures"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Margin="0,0,8,0" Height="50" HorizontalContentAlignment="Left" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Image" VerticalAlignment="Center" Width="20" Height="20"/>
                                    <TextBlock Text="Pictures" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnVideos" Click="QuickPath_Click" Tag="Videos"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Height="50" HorizontalContentAlignment="Left" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Video" VerticalAlignment="Center" Width="20" Height="20"/>
                                    <TextBlock Text="Videos" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Custom Path Input -->
                        <TextBlock Text="HOẶC NHẬP ĐƯỜNG DẪN TÙY CHỈNH" FontWeight="Bold" FontSize="13" Foreground="#616161" Margin="0,8,0,12"/>
                        <TextBox x:Name="SourcePathBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="FolderOpen"
                                 materialDesign:HintAssist.Hint="Đường dẫn thư mục (VD: Desktop, C:\MyFolder)"
                                 Text="Documents" Height="48" FontSize="14"/>

                        <Separator Margin="0,20"/>

                        <!-- File Types Selection -->
                        <TextBlock Text="ĐỊNH DẠNG TẬP TIN CẦN THU THẬP" FontWeight="Bold" FontSize="13" Foreground="#616161" Margin="0,0,0,12"/>
                        
                        <!-- Document Types -->
                        <TextBlock Text="Văn bản" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkDoc" Content=".doc/.docx" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkXls" Content=".xls/.xlsx" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkPpt" Content=".ppt/.pptx" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkPdf" Content=".pdf" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkTxt" Content=".txt" IsChecked="True" Margin="0,0,16,8"/>
                        </WrapPanel>

                        <!-- Image Types -->
                        <TextBlock Text="Hình ảnh" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkJpg" Content=".jpg/.jpeg" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkPng" Content=".png" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkGif" Content=".gif" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkBmp" Content=".bmp" Margin="0,0,16,8"/>
                        </WrapPanel>

                        <!-- Code Types -->
                        <TextBlock Text="Mã nguồn" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkCpp" Content=".cpp/.c/.h" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkCs" Content=".cs" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkPy" Content=".py" IsChecked="True" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkJava" Content=".java" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkJs" Content=".js/.ts" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkHtml" Content=".html/.css" Margin="0,0,16,8"/>
                        </WrapPanel>

                        <!-- Archive Types -->
                        <TextBlock Text="Nén" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkZip" Content=".zip" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkRar" Content=".rar" Margin="0,0,16,8"/>
                            <CheckBox x:Name="Chk7z" Content=".7z" Margin="0,0,16,8"/>
                        </WrapPanel>

                        <!-- Custom Extensions -->
                        <TextBlock Text="ĐỊNH DẠNG KHÁC (tùy chọn)" FontWeight="Bold" FontSize="13" Foreground="#616161" Margin="0,8,0,12"/>
                        <TextBox x:Name="CustomExtensionsBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="VD: sql, json, xml (cách nhau bởi dấu phẩy)"
                                 FontSize="14"/>

                        <Separator Margin="0,20"/>

                        <!-- Options -->
                        <TextBlock Text="TÙY CHỌN KHÁC" FontWeight="Bold" FontSize="13" Foreground="#616161" Margin="0,0,0,12"/>
                        <CheckBox x:Name="RecursiveCheck" Content="Quét cả thư mục con (recursive)" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkIncludeHidden" Content="Bao gồm file ẩn" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkOverwrite" Content="Ghi đè file đã tồn tại" IsChecked="True"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Student List -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Student Panel Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DANH SÁCH HỌC SINH" FontWeight="Bold" FontSize="14" Foreground="#424242" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Chọn tất cả" Click="SelectAll_Click" 
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                            <Button Content="Bỏ chọn" Click="DeselectAll_Click" 
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search Box -->
                    <TextBox x:Name="SearchBox" Grid.Row="1"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             materialDesign:HintAssist.Hint="Tìm kiếm học sinh..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Margin="0,0,0,16"
                             TextChanged="SearchBox_TextChanged"/>

                    <!-- Student DataGrid -->
                    <DataGrid Grid.Row="2" x:Name="StudentGrid" AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column" SelectionMode="Extended" CanUserAddRows="False"
                              AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E0E0E0" RowHeight="48"
                              materialDesign:DataGridAssist.CornerRadius="8">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                                    ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                    EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox x:Name="SelectAllCheckBox" Click="SelectAllCheckBox_Click"/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding DisplayName}" Width="180" FontWeight="Medium" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Máy tính" Binding="{Binding ComputerName}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Trạng thái thu thập" Binding="{Binding CollectionStatus}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#616161"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CollectionStatus}" Value="Hoàn thành">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CollectionStatus}" Value="Lỗi">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Information" Foreground="#757575" VerticalAlignment="Center" Width="20" Height="20"/>
                    <TextBlock x:Name="StatusText" Text="Sẵn sàng thu thập file từ các máy tính học sinh" 
                               Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Mở thư mục lưu file" Click="OpenFolder_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Margin="0,0,12,0">
                        <Button.ToolTip>Mở thư mục chứa các file đã thu thập</Button.ToolTip>
                    </Button>
                    <Button x:Name="BtnStartCollection" Content="Bắt đầu thu thập" Click="StartCollection_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="{StaticResource AppPrimaryBrush}" Foreground="White"
                            FontWeight="Bold">
                        <Button.ToolTip>Thu thập file từ các học sinh đã chọn</Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
