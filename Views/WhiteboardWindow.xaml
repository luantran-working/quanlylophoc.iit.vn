<Window Icon="pack://application:,,,/Resources/app.ico" x:Class="ClassroomManagement.Views.WhiteboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:ClassroomManagement.Views"
        xmlns:controls="clr-namespace:ClassroomManagement.Controls"
        Title="Bảng Trắng"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar (Optional for Info) -->
        <Border Grid.Row="0" Background="{StaticResource AppPrimaryBrush}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DrawPen" Width="24" Height="24"
                                              Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Bảng Trắng" FontSize="16" FontWeight="Bold"
                               Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="ParticipantCountText" Grid.Column="1"
                           Text=""
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <views:WhiteboardView Grid.Row="1"/>
    </Grid>
</Window>
